{
  "name": "quote-quote",
  "version": "1.3.0",
  "description": "Convert straight quotes to curly quotes — also known as smart quotes.",
  "author": "Tom Herni",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "browser": "./dist/quote-quote.min.js",
  "engines": {
    "node": ">=16.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./dist/quote-quote.min.js": "./dist/quote-quote.min.js",
    "./dist/quote-quote.esm.min.js": "./dist/quote-quote.esm.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/test"
  ],
  "unpkg": "./dist/quote-quote.min.js",
  "jsdelivr": "./dist/quote-quote.min.js",
  "sideEffects": false,
  "scripts": {
    "build": "./scripts/build.sh",
    "test": "node --test --enable-source-maps dist/esm/test/*.js",
    "lint": "eslint \"**/*.{js,ts}\" --fix",
    "lint:check": "eslint \"**/*.{js,ts}\"",
    "format": "prettier \"**/*.{js,json,md,ts}\" --write --ignore-path .gitignore",
    "format:check": "prettier \"**/*.{js,json,md,ts}\" --check --ignore-path .gitignore",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "rolldown": "^1.2.0",
    "terser": "^5.48.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomherni/quote-quote.git"
  },
  "bugs": {
    "url": "https://github.com/tomherni/quote-quote/issues"
  },
  "homepage": "https://quote-quote.tomherni.dev",
  "keywords": [
    "quotes",
    "curly",
    "smart",
    "straight",
    "typography"
  ],
  "lint-staged": {
    "**/*.{js,json,md,ts}": "prettier --write",
    "**/*.{js,ts}": "eslint --fix"
  }
}
